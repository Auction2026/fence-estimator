# ============================================================
# FENCE DEPOT ESTIMATOR - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to source control.
# ============================================================

# ─────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# development | production | test

# ─────────────────────────────────────────────────────────────
# DATABASE  (MongoDB)
# ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/fence-estimator
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/fence-estimator
MONGO_DB_NAME=fence-estimator

# ─────────────────────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d
# Time format: 1h | 7d | 30d

# ─────────────────────────────────────────────────────────────
# EMAIL  (SMTP / Nodemailer)
# ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
# true for port 465, false for 587 (STARTTLS)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
# Use an App Password, NOT your regular password
EMAIL_FROM_NAME=Fence Depot Estimator
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ─────────────────────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# In production: https://yourdomain.com

# ─────────────────────────────────────────────────────────────
# GOOGLE MAPS  (optional – for site mapping tab)
# ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ─────────────────────────────────────────────────────────────
# FILE UPLOADS
# ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─────────────────────────────────────────────────────────────
# PDF GENERATION
# ─────────────────────────────────────────────────────────────
PDF_STORAGE_DIR=pdfs
COMPANY_NAME=Fence Depot
COMPANY_ADDRESS=123 Main Street
COMPANY_CITY=Your City
COMPANY_STATE=TX
COMPANY_ZIP=75001
COMPANY_PHONE=(555) 555-1234
COMPANY_EMAIL=info@fencedepot.com
COMPANY_WEBSITE=https://fencedepot.com
COMPANY_LICENSE=FEN-12345

# ─────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# ─────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
# error | warn | info | debug
LOG_FILE=logs/app.log

# ─────────────────────────────────────────────────────────────
# STRIPE  (optional – for online payment collection)
# ─────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ─────────────────────────────────────────────────────────────
# BACKUP
# ─────────────────────────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_SCHEDULE=0 2 * * *
# Cron format: 2 AM daily
